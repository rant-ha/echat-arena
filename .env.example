# ==============================
# Empathy Arena - Local Dev / Vercel / Heroku
# ==============================

# ---------- Backend (Heroku) ----------
# OpenAI-compatible proxy (required)
OPENAI_API_BASE=
OPENAI_API_KEY=

# Choose model ids (keys in api_endpoints.json). Optional.
# Legacy multi-model switches (not recommended for controlled-variable experiments)
BASELINE_MODEL=
EMPATHY_MODEL=
EMOTION_MODEL=
EVAL_MODEL=

# Single-model / controlled variable switches (recommended)
REPLY_MODEL_NAME=
REPLY_API_BASE=
REPLY_API_KEY=

# CORS
ALLOWED_ORIGINS=*

# Supabase (service role for inserts/export)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Session cache limits
ARENA_SESSION_TTL_SEC=7200
ARENA_MAX_SESSIONS=2000

# Retry/timeout
ARENA_REQUEST_TIMEOUT=60
ARENA_MAX_RETRIES=3
ARENA_BACKOFF_BASE=1

# ---------- Archive (optional) ----------
# Enable scheduled archive on backend dyno
ARCHIVE_ENABLED=0
ARCHIVE_INTERVAL_HOURS=4

# Google Drive service account JSON (single-line JSON string!)
DRIVE_CREDS_JSON=
# Target folder ID in Google Drive
DRIVE_FOLDER_ID=

# ---------- Frontend (Vercel) ----------
# Supabase client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Next.js API routes proxy -> Heroku base URL (e.g. https://xxx.herokuapp.com)
ARENA_API_BASE=

# Optional: add a shared secret for proxy routes (if you implement it)
ARENA_API_KEY=
