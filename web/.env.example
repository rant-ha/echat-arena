# ---------- Frontend (Next.js / Vercel) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: registration allowlist, comma-separated
# Example: .edu.cn,.ac.uk
NEXT_PUBLIC_ALLOWED_DOMAINS=.edu.cn

# Next.js API routes proxy -> Heroku base URL (e.g. https://xxx.herokuapp.com)
ARENA_API_BASE=

# Optional: if your upstream expects a shared key, you can still pass it via Authorization from client
# ARENA_API_KEY=
